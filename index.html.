              {locked ? (

                <span className="shrink-0 font-mono text-[11px] text-ink-soft">Bloq.</span>

              ) : (

                <button

                  onClick={() => start(i)}

                  className="shrink-0 rounded-2xl bg-coral px-3.5 py-2.5 text-[13px] font-bold text-white shadow-[0_5px_0_var(--color-coral-deep)] active:translate-y-[3px] active:shadow-[0_2px_0_var(--color-coral-deep)]"

                >

                  Iniciar

                </button>

              )}

            </div>

          );

        })}

      </section>

      {active !== null && (

        <section className="mt-7 px-5">

          <p className="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase">

            Misión {String(active + 1).padStart(2, "0")} · en curso

          </p>

          <div className="mt-3 rounded-[28px] bg-ink p-6 text-paper shadow-[0_16px_0_-6px_var(--color-ink-deep)]">

            <div className="flex items-center gap-5">

              <div className="relative grid size-24 shrink-0 place-items-center">

                <span className="absolute inset-0 rounded-full border-4 border-white/15" />

                <span className="dial absolute inset-0 rounded-full border-4 border-mint border-t-transparent" />

                <div className="text-center leading-none">

                  <span className="text-3xl font-bold">{left}</span>

                  <span className="mt-1 block font-mono text-[9px] text-white/50">SEG</span>

                </div>

              </div>

              <div className="min-w-0">

                <p className="text-[16px] font-semibold tracking-tight">

                  {MISSIONS[active]!.title}

                </p>

                <p className="mt-1 text-[12px] text-white/60 text-pretty">

                  Vuelve aquí al llegar a 0s y la misión quedará hecha.

                </p>

                <div className="mt-3 h-2 overflow-hidden rounded-full bg-white/15">

                  <div

                    className="h-full rounded-full bg-mint transition-all duration-1000"

                    style={{ width: `${((DURATION - left) / DURATION) * 100}%` }}

                  />

                </div>

              </div>

            </div>

          </div>

        </section>

      )}

      <section className="mt-6 px-5 pb-8">

        <button

          disabled={!allDone}

          onClick={() => setStage("key")}

          className={

            allDone

              ? "w-full rounded-3xl bg-ink py-4 text-[15px] font-bold tracking-tight text-paper shadow-[0_8px_0_var(--color-ink-deep)] active:translate-y-[3px] active:shadow-[0_3px_0_var(--color-ink-deep)]"

              : "w-full rounded-3xl bg-track py-4 text-[15px] font-bold tracking-tight text-ink-soft/70 ring-1 ring-ink/5"

          }

        >

          {allDone ? "Continuar" : `Continuar · ${completed} / 3 misiones`}

        </button>

      </section>

    </div>

  );

}
