function randomKey() {

  const n = Math.floor(100 + Math.random() * 900);

  const w = WORDS[Math.floor(Math.random() * WORDS.length)];

  const w2 = WORDS[Math.floor(Math.random() * WORDS.length)];

  const d = Math.floor(10 + Math.random() * 90);

  return `${n}-${w}-${w2}${d}`;

}

