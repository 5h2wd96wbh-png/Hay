<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Script Store</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #070a0f;
    color: white;
    min-height: 100vh;
}

button, input {
    font: inherit;
}

.hidden {
    display: none !important;
}

/* LOGIN */
.login-screen {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.login-box {
    width: 100%;
    max-width: 420px;
    background: #10151d;
    border: 1px solid #293341;
    border-radius: 22px;
    padding: 35px 25px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
}

.logo {
    font-size: 38px;
    font-weight: 800;
    margin-bottom: 10px;
}

.subtitle {
    color: #8e99a8;
    margin-bottom: 25px;
}

input {
    width: 100%;
    padding: 15px;
    border-radius: 12px;
    border: 1px solid #354050;
    background: #080c12;
    color: white;
    outline: none;
    margin-bottom: 12px;
}

input:focus {
    border-color: #4c9aff;
}

.btn {
    border: 0;
    border-radius: 12px;
    padding: 14px 20px;
    cursor: pointer;
    font-weight: 700;
    width: 100%;
    background: #2374e1;
    color: white;
}

.btn:hover {
    opacity: .9;
}

.error {
    color: #ff6b6b;
    margin-top: 12px;
}

/* APP */
.app {
    min-height: 100vh;
}

header {
    height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 25px;
    border-bottom: 1px solid #202a36;
    background: #0b0f15;
    position: sticky;
    top: 0;
    z-index: 10;
}

.brand {
    font-size: 22px;
    font-weight: 800;
}

.admin-btn {
    width: auto;
    padding: 10px 16px;
    background: #171e28;
    border: 1px solid #354050;
}

main {
    max-width: 1000px;
    margin: auto;
    padding: 45px 20px;
}

.hero {
    margin-bottom: 35px;
}

.hero h1 {
    font-size: 45px;
    margin-bottom: 10px;
}

.hero p {
    color: #8e99a8;
}

.section-title {
    font-size: 25px;
    margin: 35px 0 18px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
}

.card {
    background: #10151d;
    border: 1px solid #293341;
    border-radius: 18px;
    padding: 24px;
}

.card h3 {
    margin-bottom: 10px;
}

.card p {
    color: #8e99a8;
    margin-bottom: 18px;
}

.card .btn {
    width: auto;
}

/* PAYMENT */
.payment {
    margin-top: 35px;
}

.price {
    font-size: 35px;
    font-weight: 800;
    margin: 12px 0 20px;
}

.notice {
    padding: 15px;
    border-radius: 12px;
    background: #171e28;
    color: #aab4c2;
    margin-bottom: 20px;
}

.timer {
    font-size: 48px;
    font-weight: 800;
    text-align: center;
    margin: 20px 0;
}

.waiting {
    text-align: center;
    color: #75aefc;
    font-weight: 700;
}

/* ADMIN */
.admin-panel {
    margin-top: 35px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.stat {
    background: #10151d;
    border: 1px solid #293341;
    border-radius: 16px;
    padding: 20px;
}

.stat-number {
    font-size: 32px;
    font-weight: 800;
    margin-top: 8px;
}

.back {
    margin-top: 20px;
    background: #171e28;
    border: 1px solid #354050;
}

@media(max-width:600px) {
    header {
        padding: 0 15px;
    }

    .hero h1 {
        font-size: 35px;
    }

    main {
        padding: 30px 15px;
    }
}
</style>
</head>

<body>

<!-- LOGIN -->
<div id="loginScreen" class="login-screen">
    <div class="login-box">
        <div class="logo">SCRIPT STORE</div>
        <div class="subtitle">Enter the password to continue</div>

        <input
            id="loginPassword"
            type="password"
            placeholder="Password"
        >

        <button class="btn" onclick="login()">
            Enter Website
        </button>

        <div id="loginError" class="error"></div>
    </div>
</div>


<!-- WEBSITE -->
<div id="website" class="app hidden">

<header>
    <div class="brand">SCRIPT STORE</div>

    <button class="btn admin-btn" onclick="openAdmin()">
        Admin
    </button>
</header>

<main>

<section class="hero">
    <h1>Welcome 👋</h1>
    <p>Choose a category below.</p>
</section>


<section>
    <div class="section-title">Script</div>

    <div class="cards">

        <div class="card">
            <h3>DVM</h3>
            <p>Script option.</p>

            <button class="btn" onclick="selectScript('DVM')">
                Select
            </button>
        </div>

        <div class="card">
            <h3>Spin Block</h3>
            <p>Script option.</p>

            <button class="btn" onclick="selectScript('Spin Block')">
                Select
            </button>
        </div>

    </div>
</section>


<section class="payment">

    <div class="section-title">Payment</div>

    <div class="card">

        <h3 id="selectedProduct">
            Duelo
        </h3>

        <div class="price">
            $5
        </div>

        <div class="notice">
            Demo payment screen. No real payment is processed by this page.
        </div>

        <button class="btn" onclick="startPurchase()">
            Comprar
        </button>

        <div id="paymentArea" class="hidden">

            <div class="notice" style="margin-top:20px;">
                Follow the payment instructions provided by the site owner.
                Do not enter sensitive financial information here.
            </div>

            <div class="timer" id="timer">
                1:00
            </div>

            <div class="waiting">
                Espera a que un admin te dé la key.
            </div>

        </div>

    </div>

</section>

</main>
</div>


<!-- ADMIN LOGIN -->
<div id="adminLogin" class="login-screen hidden">

    <div class="login-box">

        <div class="logo">ADMIN</div>

        <div class="subtitle">
            Administrator access
        </div>

        <input
            id="adminPassword"
            type="password"
            placeholder="Admin password"
        >

        <button class="btn" onclick="checkAdmin()">
            Enter Admin
        </button>

        <div id="adminError" class="error"></div>

        <button class="btn back" onclick="closeAdmin()">
            Back
        </button>

    </div>

</div>


<!-- ADMIN PANEL -->
<div id="adminPanel" class="app hidden">

<header>
    <div class="brand">ADMIN PANEL</div>

    <button class="btn admin-btn" onclick="closeAdminPanel()">
        Exit
    </button>
</header>

<main>

    <section class="hero">
        <h1>Dashboard</h1>
        <p>Local demonstration statistics.</p>
    </section>

    <div class="stats">

        <div class="stat">
            <div>Website visits</div>
            <div id="visitCount" class="stat-number">0</div>
        </div>

        <div class="stat">
            <div>Purchases</div>
            <div id="purchaseCount" class="stat-number">0</div>
        </div>

        <div class="stat">
            <div>Last product</div>
            <div id="lastProduct" class="stat-number"
                 style="font-size:20px;">
                None
            </div>
        </div>

    </div>

    <div class="section-title">
        Activity
    </div>

    <div id="activity" class="card">
        No activity yet.
    </div>

</main>

</div>


<script>

/*
    DEMO LOGIN

    IMPORTANT:
    Passwords stored in frontend code are NOT secure.
    Anyone can inspect the page source.
*/

const USER_PASSWORD = "ilover";
const ADMIN_PASSWORD = "iloveyoubaby";


// -------------------------
// LOGIN
// -------------------------

function login() {

    const password =
        document.getElementById("loginPassword").value;

    if (password === USER_PASSWORD) {

        document
            .getElementById("loginScreen")
            .classList.add("hidden");

        document
            .getElementById("website")
            .classList.remove("hidden");

        recordVisit();

    } else {

        document
            .getElementById("loginError")
            .textContent =
            "Incorrect password.";

    }
}


// Enter key
document
    .getElementById("loginPassword")
    .addEventListener("keydown", function(e) {

        if (e.key === "Enter") {
            login();
        }

    });


// -------------------------
// SCRIPT SELECTION
// -------------------------

function selectScript(name) {

    alert("Selected: " + name);

}


// -------------------------
// PURCHASE
// -------------------------

let timerInterval = null;

function startPurchase() {

    document
        .getElementById("paymentArea")
        .classList.remove("hidden");

    recordPurchase("Duelo");

    let seconds = 60;

    clearInterval(timerInterval);

    updateTimer(seconds);

    timerInterval = setInterval(function() {

        seconds--;

        updateTimer(seconds);

        if (seconds <= 0) {

            clearInterval(timerInterval);

            document
                .getElementById("timer")
                .textContent = "00:00";

        }

    }, 1000);
}


function updateTimer(seconds) {

    const minutes =
        Math.floor(seconds / 60);

    const secs =
        seconds % 60;

    document
        .getElementById("timer")
        .textContent =
        minutes + ":" +
        String(secs).padStart(2, "0");
}


// -------------------------
// LOCAL STATISTICS
// -------------------------

function getData() {

    return JSON.parse(
        localStorage.getItem("scriptStoreData") ||
        '{"visits":0,"purchases":0,"lastProduct":"None","activity":[]}'
    );

}


function saveData(data) {

    localStorage.setItem(
        "scriptStoreData",
        JSON.stringify(data)
    );

}


function recordVisit() {

    const data = getData();

    data.visits++;

    data.activity.unshift(
        "Someone entered the website."
    );

    data.activity =
        data.activity.slice(0, 20);

    saveData(data);

}


function recordPurchase(product) {

    const data = getData();

    data.purchases++;

    data.lastProduct = product;

    data.activity.unshift(
        "Purchase: " + product
    );

    data.activity =
        data.activity.slice(0, 20);

    saveData(data);

}


// -------------------------
// ADMIN
// -------------------------

function openAdmin() {

    document
        .getElementById("website")
        .classList.add("hidden");

    document
        .getElementById("adminLogin")
        .classList.remove("hidden");

}


function closeAdmin() {

    document
        .getElementById("adminLogin")
        .classList.add("hidden");

    document
        .getElementById("website")
        .classList.remove("hidden");

}


function checkAdmin() {

    const password =
        document.getElementById("adminPassword").value;

    if (password === ADMIN_PASSWORD) {

        document
            .getElementById("adminLogin")
            .classList.add("hidden");

        document
            .getElementById("adminPanel")
            .classList.remove("hidden");

        loadAdmin();

    } else {

        document
            .getElementById("adminError")
            .textContent =
            "Incorrect admin password.";

    }

}


function loadAdmin() {

    const data = getData();

    document
        .getElementById("visitCount")
        .textContent = data.visits;

    document
        .getElementById("purchaseCount")
        .textContent = data.purchases;

    document
        .getElementById("lastProduct")
        .textContent = data.lastProduct;

    const activity =
        document.getElementById("activity");

    if (data.activity.length === 0) {

        activity.textContent =
            "No activity yet.";

    } else {

        activity.innerHTML =
            data.activity
            .map(item => "<p style='margin-bottom:10px;'>• "
                + escapeHTML(item)
                + "</p>")
            .join("");

    }

}


function escapeHTML(text) {

    const div = document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


function closeAdminPanel() {

    document
        .getElementById("adminPanel")
        .classList.add("hidden");

    document
        .getElementById("website")
        .classList.remove("hidden");

}

</script>

</body>
</html>
